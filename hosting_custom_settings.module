<?php
/**
 * @file
 * Code for the Hosting Custom Settings feature.
 */

include_once 'hosting_custom_settings.features.inc';

/**
 * Exported permissions whose defining module is not enabled on this box.
 *
 * The CMS-support modules (hosting_backdrop, hosting_grav, hosting_txp) ship
 * dark and are enabled per box by a BOA control-file switch, so their task
 * permissions are exported here WITHOUT a features dependency: a dependency
 * would force-enable the module on every box and defeat the switch. Where the
 * module is disabled its permissions are undefined, and Features would then
 * warn on every revert and report this feature overridden for good. The two
 * alter hooks below drop exactly those entries from both sides of the
 * comparison, so the export is enforced wherever the module runs and silent
 * where it does not. Not cached: one drush run can enable a module and
 * rebuild the module data before it ends, and a stale answer here would
 * strip the entries the rebuild is meant to pick up.
 *
 * @return array
 *   Permission names, keyed by name.
 */
function _hosting_custom_settings_dark_permissions() {
  $dark = array();
  module_load_include('inc', 'hosting_custom_settings', 'hosting_custom_settings.features.user_permission');
  if (!function_exists('hosting_custom_settings_user_default_permissions')) {
    return $dark;
  }
  foreach (hosting_custom_settings_user_default_permissions() as $name => $permission) {
    if (!empty($permission['module']) && !module_exists($permission['module'])) {
      $dark[$name] = $name;
    }
  }
  return $dark;
}

/**
 * Implements hook_user_default_permissions_alter().
 *
 * The code side of the comparison and the list the revert rebuilds from.
 */
function hosting_custom_settings_user_default_permissions_alter(&$permissions) {
  $dark = _hosting_custom_settings_dark_permissions();
  if ($dark) {
    $permissions = array_diff_key($permissions, $dark);
  }
}

/**
 * Implements hook_system_info_alter().
 *
 * The database side: features_get_normal() renders every permission the .info
 * file lists, so the same entries have to leave that list too or the feature
 * still reads as overridden on a box where the module is disabled.
 */
function hosting_custom_settings_system_info_alter(&$info, $file, $type) {
  if ($type != 'module' || $file->name != 'hosting_custom_settings' || empty($info['features']['user_permission'])) {
    return;
  }
  $dark = _hosting_custom_settings_dark_permissions();
  if ($dark) {
    $info['features']['user_permission'] = array_values(array_diff($info['features']['user_permission'], $dark));
  }
}

/**
 * Implements hook_permission().
 *
 * hosting_site_backup_manager gates its Export, Get, Delete and Restore
 * routes by node view access alone, so any panel user who can see a site can
 * pull its full database dump out of the Backups tab. This is the missing
 * gate for the export and download routes; the delete and restore routes are
 * mapped to the task permissions the site page already enforces (see
 * hosting_custom_settings_menu_alter()). Exported to the roles that hold
 * 'create backup task', so nothing changes for them.
 */
function hosting_custom_settings_permission() {
  return array(
    'download site backups' => array(
      'title' => t('Download site backups'),
      'description' => t('Make a site backup exportable and download the archive from the Backups tab. The archive carries the full database dump.'),
      'restrict access' => TRUE,
    ),
  );
}

/**
 * Implements hook_menu_alter().
 *
 * The backup manager's routes keep their page callbacks; only the access side
 * changes, and the two list callbacks are wrapped so the buttons of denied
 * actions do not render. Guarded on the items' presence: the module is
 * enabled on every BOA instance, but the alter must stay a no-op where it is
 * not, and must not wrap a callback something else already replaced.
 */
function hosting_custom_settings_menu_alter(&$items) {
  $gates = array(
    'node/%node/backup/export/%' => 'download site backups',
    'node/%node/backup/download/%' => 'download site backups',
    'node/%node/backup/delete/%' => 'create backup-delete task',
    'node/%node/backup/restore/%' => 'create restore task',
  );
  foreach ($gates as $path => $permission) {
    if (isset($items[$path])) {
      $items[$path]['access callback'] = 'hosting_custom_settings_backup_access';
      $items[$path]['access arguments'] = array($permission, 1);
    }
  }
  $wrappers = array(
    'node/%node/backups' => array('hosting_site_backup_manager_page', 'hosting_custom_settings_backup_page'),
    'node/%node/ajax/backups' => array('hosting_site_backup_manager_ajax_list', 'hosting_custom_settings_backup_ajax_list'),
  );
  foreach ($wrappers as $path => $callbacks) {
    if (isset($items[$path]) && isset($items[$path]['page callback']) && $items[$path]['page callback'] == $callbacks[0]) {
      $items[$path]['page callback'] = $callbacks[1];
    }
  }
}

/**
 * Access callback for the gated backup routes.
 *
 * @param string $permission
 *   The permission the route needs on top of viewing the site.
 * @param object $node
 *   The node the %node loader resolved.
 *
 * @return bool
 *   TRUE when the current user holds the permission and may view the site.
 */
function hosting_custom_settings_backup_access($permission, $node) {
  return is_object($node) && isset($node->type) && $node->type == 'site' && user_access($permission) && node_access('view', $node);
}

/**
 * Page callback: the Backups tab without the buttons of denied actions.
 */
function hosting_custom_settings_backup_page($site) {
  return _hosting_custom_settings_backup_strip(hosting_site_backup_manager_page($site), $site);
}

/**
 * Page callback: the AJAX refresh of the same table, stripped the same way.
 */
function hosting_custom_settings_backup_ajax_list($site) {
  $return = array('markup' => _hosting_custom_settings_backup_strip(hosting_site_backup_manager_backups_table($site), $site));
  drupal_json_output($return);
  exit();
}

/**
 * Drop the buttons of the actions the current user may not take.
 *
 * Presentation only: the access callbacks above are the boundary. The table
 * builder renders every action for every viewer, as either the
 * _hosting_task_button() anchor or its disabled span, so both forms are
 * matched by route and label; the "Create a new backup" link goes with the
 * backup task permission.
 *
 * @param string $markup
 *   The rendered table.
 * @param object $site
 *   The site node.
 *
 * @return string
 *   The table without the denied buttons.
 */
function _hosting_custom_settings_backup_strip($markup, $site) {
  $actions = array(
    'download' => array('download site backups', t('Get')),
    'export' => array('download site backups', t('Export')),
    'delete' => array('create backup-delete task', t('Delete')),
    'restore' => array('create restore task', t('Restore')),
  );
  $nid = (int) $site->nid;
  foreach ($actions as $route => $action) {
    if (user_access($action[0])) {
      continue;
    }
    $label = preg_quote($action[1], '#');
    $markup = preg_replace('#<a\b[^>]*\bhref="[^"]*/node/' . $nid . '/backup/' . $route . '/[0-9]+[^"]*"[^>]*>' . $label . '</a>#', '', $markup);
    $markup = preg_replace('#<span class=\'hosting-button-disabled\'>' . $label . '</span>#', '', $markup);
  }
  if (!user_access('create backup task')) {
    $markup = preg_replace('#(&nbsp;)?<a\b[^>]*\bhref="[^"]*/hosting_confirm/' . $nid . '/site_backup(\?[^"]*)?"[^>]*>[^<]*</a>#', '', $markup);
  }
  return $markup;
}

/**
 * Implements hook_features_post_restore().
 *
 * A revert walks the components in .info order, user_permission before
 * user_role, so on the pass that first creates a role exported here the
 * permission rebuild runs while the role does not exist yet and skips its
 * grants; the role is then created empty and the feature reads Overridden
 * until the next pass. Rebuilding the permissions once more after a pass that
 * touched our roles closes that window in the same run (idempotent: the
 * rebuild writes the exported state, nothing else).
 */
function hosting_custom_settings_features_post_restore($op, $items) {
  if (empty($items['hosting_custom_settings']) || !in_array('user_role', $items['hosting_custom_settings'])) {
    return;
  }
  module_load_include('inc', 'features', 'includes/features.user');
  if (function_exists('user_permission_features_rebuild')) {
    user_permission_features_rebuild('hosting_custom_settings');
  }
}
